APP_NAME="Search Engine"
APP_ENV=local
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=true
APP_URL=https://search.example.com
APP_PORT=8080
APP_DOMAIN=search.example.com

# SSL — set SSL_ENABLED=false for HTTP-only (no certificate required, ideal for local dev).
# Set SSL_ENABLED=true and provide the three certificate file paths for HTTPS.
# Certificates are mounted into the Nginx container at /etc/nginx/certs/.
# Renewal is managed externally; replace the files and run:
#   docker compose -f docker-compose-local.yml exec nginx nginx -s reload
# If SSL_PORT conflicts with another service, change it to any free port.
SSL_ENABLED=true
SSL_PORT=443
SSL_CERT=etc/ssl/certs/search.example.com/domain.com.crt
SSL_CA_BUNDLE=/etc/ssl/certs/search.example.com/domain.com.ca-bundle
SSL_KEY=/etc/ssl/private/search.example.com/domain.com_key.txt

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=search_engine
DB_USERNAME=search_engine
DB_PASSWORD=apassword
DB_EXTERNAL_PORT=3307
DB_ROOT_PASSWORD=arootpassword

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_CONNECTION=session
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

REDIS_HOST=redis
REDIS_PASSWORD=null
# Logical Redis DBs, isolated per subsystem: queue (default conn), cache, sessions.
REDIS_DB=3
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6380

# Company/tenant id (string, no spaces). Drives the ES index name
# (<COMPANY_ID>_products) and synonym set (<COMPANY_ID>_synonyms).
COMPANY_ID=ams

ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=
# Products index name is derived from COMPANY_ID (COMPANY_ID_products).
ELASTICSEARCH_ANALYTICS_INDEX=search_analytics
ELASTICSEARCH_REPLICA_COUNT=1
ELASTICSEARCH_SHARD_COUNT=3

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secret

# Grafana
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# Kibana
KIBANA_PORT=5601

# ES port
ES_PORT=9200

# Benchmark config
BENCHMARK_P95_SEARCH_THRESHOLD_MS=300
BENCHMARK_P95_SUGGEST_THRESHOLD_MS=100
BENCHMARK_PRECISION10_DROP_THRESHOLD=5
BENCHMARK_NDCG10_DROP_THRESHOLD=5

# Search config
SEARCH_PER_PAGE_DEFAULT=24
SEARCH_PER_PAGE_MAX=100
SEARCH_AUTOCOMPLETE_LIMIT=10
SEARCH_FUZZY_ENABLED=true
SEARCH_FUZZY_AUTO=true
SEARCH_MIN_SCORE=0.01
