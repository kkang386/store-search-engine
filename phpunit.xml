<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>

    <php>
        <!-- Tests run against a DEDICATED MySQL database (search_engine_test), never
             the real one — the migrations use MySQL-specific DDL so sqlite is not an
             option. NOTE: the Docker container sets DB_DATABASE=search_engine in
             $_SERVER, and Laravel's env() reads $_SERVER first, so these <env>/<server>
             entries cannot be relied on alone — tests/TestCase.php forces DB_DATABASE
             to the test database before the app boots and hard-aborts otherwise. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_DATABASE" value="search_engine_test" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>

        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:testtesttesttesttesttesttesttesttesttest=" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_DATABASE" value="search_engine_test" force="true"/>
        <env name="ELASTICSEARCH_HOST" value="localhost" force="true"/>
        <env name="ELASTICSEARCH_PORT" value="9200" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
    </php>
</phpunit>
