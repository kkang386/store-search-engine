      "click_position": { "type": "integer" },
      "converted": { "type": "boolean" },
      "revenue": { "type": "float" },
      "latency_ms": { "type": "integer" },
      "filters_applied": { "type": "keyword" },
      "facets_used": { "type": "keyword" },
      "sort_order": { "type": "keyword" },
      "timestamp": { "type": "date" },
      "type": { "type": "keyword" }
    }
  }
}
