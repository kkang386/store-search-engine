# Environment
.env
.env.*
!.env.example
!.env.local
# Per-environment local secret files (note: .env.* does NOT match .env-local-*)
.env-local*
/.gitignore-all/

# SSL certificates (never commit private keys or certs) — whole certs/ dir,
# including any dated subdirectories
docker/nginx/certs/*
!docker/nginx/certs/.gitkeep

# Dependencies
/vendor/
/node_modules/

# Laravel generated
/bootstrap/cache/*.php
/storage/*.key
/storage/app/public/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
/storage/app/benchmarks/*
/storage/app/private/benchmarks/*
/storage/app/private/imports/*

# Build artifacts
/public/hot
/public/storage
/public/build

# Composer
composer.phar
composer.lock

# OS
.DS_Store
Thumbs.db

# IDE / local tooling
.idea/
.vscode/
.claude/
*.swp
*.swo

# Docker volumes (local data)
docker/mysql/data/
docker/elasticsearch/data/
docker/ssh/authorized_keys
